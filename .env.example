# Copy this file to .env and fill in real values. Never commit .env.

NAS_ADDR=replace_me
SMB_SHARE=replace_me
SMB_USER=replace_me
# Single quotes stop Compose expanding any $ in the password.
# A comma won't work here: Docker splits the mount options on commas.
SMB_PASSWORD='replace_me'

# What GogKeeper downloads, in lgogdownloader's format. Join several with +.
# Platforms: w (Windows), m (Mac), l (Linux). Languages: en, de, fr and so on.
# Note: the engine labels every extra Windows and English, whatever its language.
GOGKEEPER_PLATFORM=replace_me
GOGKEEPER_LANGUAGE=replace_me
